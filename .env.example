# DROP6 environment variables (format examples only - never commit real values)

# HTTP port. Render injects PORT automatically.
PORT=3000
HOST=0.0.0.0

# WebRTC ICE servers as a JSON array. Without TURN, some networks cannot connect.
# Leave unset to use the default public STUN server.
# Set to [] to disable STUN/TURN completely (local testing only).
ICE_SERVERS_JSON=[{"urls":["stun:stun.example.com:3478"]},{"urls":["turn:turn.example.com:3478"],"username":"replace-me","credential":"replace-me"}]

# Optional: Cloudflare Realtime TURN. Set BOTH; the server then generates TURN credentials
# valid for 2h (refreshed every hour, shared by all visitors) and adds them to the servers above.
# Leave empty to disable.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Optional usage limit for the TURN above. Set BOTH; the server then reads how much data the TURN key
# sent over the last 31 days and stops handing out TURN credentials at TURN_MONTHLY_LIMIT_GB.
# The token needs the "Account Analytics: Read" permission (it is not the TURN key token).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_API_TOKEN=
# Default is 800 (GB over the last 31 days). Only valid together with the two settings above.
# TURN_MONTHLY_LIMIT_GB=800

# How many reverse-proxy hops sit in front of this server (used to read the
# client IP from X-Forwarded-For for the join rate limit). 0 = no proxy.
TRUST_PROXY_HOPS=0
